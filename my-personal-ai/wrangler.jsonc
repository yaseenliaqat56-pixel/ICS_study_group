{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-personal-ai-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "721045",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
